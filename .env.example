# Copy to .env and edit. Values in .env OVERRIDE variables already set in the
# environment (dotenv is loaded with override: true), so leave a setting
# commented out unless you want it to win. CLI flags, where they exist, beat
# both. Commented values below are the defaults.

# --- Figma credentials -------------------------------------------------------

# Your Figma API access token
# Get it from your Figma account settings: https://www.figma.com/developers/api#access-tokens
FIGMA_API_KEY=your_figma_api_key_here

# Figma OAuth access token (--figma-oauth-token). Takes precedence over
# FIGMA_API_KEY when both are set. Never refreshed by the server.
# FIGMA_OAUTH_TOKEN=

# In HTTP mode both may be left unset; callers then send X-Figma-Token (or
# Authorization: Bearer) per request. Must be unset when MCP_INTERNAL_TOKEN is
# set, or the server refuses to start.

# --- Integration test fixtures (src/tests/integration.test.ts) ---------------

# Figma file key for testing
# This is the ID in your Figma URL: https://www.figma.com/file/{FILE_KEY}/filename
FIGMA_FILE_KEY=your_figma_file_key_here

# Figma node ID for Testing
# This is the node-id parameter in your Figma URL: ?node-id={NODE_ID}
FIGMA_NODE_ID=your_figma_node_id_here

# --- HTTP server ---------------------------------------------------------------

# Bind address (--host). Use 0.0.0.0 inside a container.
# FRAMELINK_HOST=127.0.0.1

# Port (--port). PORT is still accepted as a legacy alias when this is unset.
FRAMELINK_PORT=3333

# Comma-separated Host-header allow-list (case-insensitive). Unset: only
# loopback names are accepted when bound to loopback, and ANY Host is accepted
# when bound to 0.0.0.0.
# LOGICFLOW_ALLOWED_HOSTS=figma-mcp,localhost

# Shared secret callers must send in X-Internal-Auth on /mcp and /sse; at least
# 32 characters (openssl rand -hex 32). Unset: the endpoint is unauthenticated.
# When set, Authorization headers are ignored and FIGMA_API_KEY /
# FIGMA_OAUTH_TOKEN must be unset.
# MCP_INTERNAL_TOKEN=

# --- Figma API requests ------------------------------------------------------

# Timeout for each Figma API call in milliseconds, including reading the body.
# Missing, zero or non-numeric values fall back to the default.
# FIGMA_TIMEOUT_MS=120000

# Explicit proxy for Figma traffic (--proxy), e.g. http://proxy:8080. Use
# "none" to ignore the standard proxy variables below.
# FIGMA_PROXY=

# Standard proxy variables (upper or lower case), used only when FIGMA_PROXY is
# unset. NO_PROXY exclusions are respected.
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=

# --- Output ----------------------------------------------------------------------

# Output format: "tree", "yaml", or "json". Defaults to "tree" — it's the most
# compact (~half the size of yaml) and best for LLM consumers. Use "json" if a
# consumer parses it more reliably, or "yaml" for a more human-readable middle.
#
# OUTPUT_FORMAT="yaml"

# --- Image downloads -----------------------------------------------------------

# "true" removes the download_figma_images tool entirely
# (--skip-image-downloads). Only the exact strings "true" and "false" count.
# SKIP_IMAGE_DOWNLOADS=false

# Root directory image downloads are written under (--image-dir); downloads
# cannot escape it. Defaults to the server's working directory.
# IMAGE_DIR=

# --- Telemetry -----------------------------------------------------------------

# Usage telemetry (PostHog) is ON by default. "off" disables it, as do a
# non-empty DO_NOT_TRACK other than "0" and the --no-telemetry flag.
FRAMELINK_TELEMETRY=off
# DO_NOT_TRACK=1

# --- Runtime mode --------------------------------------------------------------

# "cli" forces stdio mode (same as --stdio). "development" also writes raw and
# simplified Figma responses to logs/ — never use it with real tenant data.
# NODE_ENV=production
